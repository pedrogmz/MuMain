/* Kryon theme: forked from themes/modern/letter_write.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* The foreground of a letter being written: its own chrome, content and buttons, all in the main
   context like every other window of this family.

   Text stays dp: this theme's window_shell body carries no `native-text` class and its sibling
   dialogs size the same way. */

/* An id beats .center-both's own transform, which window_shell cancels through a class toggle that
   two single-class selectors decide by link order. */
#panel { transform: none; }
#panel { width: 400dp; height: 292dp; min-width: 350dp; min-height: 240dp; max-width: 100%; max-height: 100%; background-color: transparent; decorator: none; border-width: 0; font-family: "token(font-body)"; font-size: 10dp; color: token(text-primary); }

/* .modern-frame paints the body itself, which window_shell's own rules leave transparent here, so
   the panel's fill is a div of its own. The inset edge and groove are off; #frame_fill carries the
   edge instead. */
.modern-shell-edge, .modern-groove, .modern-joint, .modern-header-accent { display: none; }
#frame_fill
{
	position: absolute;
	left: -12dp;
	top: 0;
	right: -12dp;
	bottom: -16dp;
	background-color: rgba(20, 16, 12, 196);
	decorator: linear-gradient(to bottom, rgba(40, 30, 20, 196) 0%, rgba(20, 16, 12, 196) 45%, rgba(8, 6, 4, 196) 100%);
	border-width: 2dp;
	border-top-color: rgba(224, 177, 88, 160);
	border-left-color: rgba(224, 177, 88, 160);
	border-bottom-color: rgba(0, 0, 0, 190);
	border-right-color: rgba(0, 0, 0, 190);
}
/* Only this strip drags. The rail reaches down over the content, so a press on a label would
   otherwise drag the window from there. */
#drag_strip { position: absolute; left: -12dp; right: -12dp; top: 0; height: 38dp; pointer-events: auto; }

.window-shell-content, .window-shell-content.has-title
{
	left: 12dp;
	right: 12dp;
	top: 0;
	bottom: 14dp;
	padding: 0;
	display: block;
	pointer-events: none;
	background-color: transparent;
	decorator: none;
	border-width: 0;
}

div { display: block; }
button { font-family: "token(font-body)"; font-size: 10dp; color: token(text-secondary); cursor: pointer; pointer-events: auto; }

#window_controls { position: absolute; right: -2dp; top: 17dp; z-index: 10; pointer-events: auto; }
#window_controls button { display: inline-block; box-sizing: border-box; width: 16dp; height: 16dp; margin-left: 4dp; padding: 0; line-height: 14dp; text-align: center; font-size: 12dp; color: token(text-muted); background-color: token(surface-control); border: 1dp token(border-inner); }
#window_controls button:hover { color: token(text-primary); border-color: token(border-hover); }
#btn_minimize:before { content: "-"; }
#btn_close_x:before { content: "x"; }
#btn_close_x:hover { color: token(accent-crimson-hover); border-color: token(accent-crimson); }

.btn { position: relative; display: inline-block; box-sizing: border-box; width: auto; height: 18dp; padding: 0 3dp; line-height: 16dp; vertical-align: top; text-align: center; overflow: hidden; pointer-events: auto; background-color: token(surface-raised); border: 1dp token(border-inner); decorator: none; }
.btn:hover { background-color: token(surface-control); border-color: token(border-hover); color: token(text-primary); }
.btn.disabled { pointer-events: none; color: token(text-disabled); border-color: token(border-recessed); }

/* Receiver and title, a label column then the field, as InitControls() measured and placed them. */
#rows { position: absolute; left: 0; right: 128dp; top: 46dp; pointer-events: auto; }
.row { display: flex; height: 18dp; margin-bottom: 3dp; white-space: nowrap; }
.row .label { flex: 0 0 56dp; height: 18dp; line-height: 18dp; overflow: hidden; color: token(text-muted); }
.row .text-field { flex: 1 1 auto; box-sizing: border-box; width: auto; height: 18dp; pointer-events: auto; }

/* The field fills a positioned box rather than being positioned itself: a textarea takes its own
   width from cols/rows, so left/right offsets alone leave it at its intrinsic size. */
#body_wrap { position: absolute; left: 0; right: 128dp; top: 92dp; bottom: 22dp; }
#body_field { width: 100%; height: 100%; box-sizing: border-box; pointer-events: auto; }

/* The sender's well, which #photo_image fills. */
#photo_slot { position: absolute; right: 0; width: 122dp; top: 46dp; bottom: 22dp; background-color: token(surface-recessed); border: 1dp token(border-recessed); pointer-events: auto; cursor: move; }
/* The viewer's render target: the character drawn into a texture exactly this box's size, so it is
   shown 1:1 and stands at this panel's depth. Webzen's logo takes its place at the original's 80x62. */
#photo_image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#photo_slot.webzen #photo_image { left: 50%; top: 50%; width: 80dp; height: 62dp; margin-left: -40dp; margin-top: -31dp; }
/* The "?" in the well's bottom-left corner, drawn a pixel smaller and inset while its help is open --
   the original's pressed look. Webzen's letter had none. */
@spritesheet photo-help-sheet { src: "../../../win_question.tga"; photo-help: 0px 0px 16px 16px; photo-help-pressed: 0px 0px 15px 15px; }
#photo_help { position: absolute; left: 1dp; bottom: 1dp; width: 16dp; height: 16dp; pointer-events: auto; cursor: pointer; decorator: image(photo-help); }
#photo_help.active { left: 2dp; width: 15dp; height: 15dp; decorator: image(photo-help-pressed); }
#photo_slot.webzen #photo_help { display: none; }

#footer { position: absolute; left: 0; right: 0; bottom: 0; height: 20dp; white-space: nowrap; }
#footer .btn { width: 20%; margin-right: 1%; font-size: 9dp; }
#footer .btn.pose { width: 28%; }


/* --------------------------------------------------------------------------
   Kryon letter chrome: the loader's double gold ring around the obsidian plate.
   -------------------------------------------------------------------------- */
#frame_fill {
	background-color: rgba(12, 9, 6, 220);
	decorator:
		radial-gradient(ellipse at top, rgba(202, 132, 38, 30), transparent 62%),
		linear-gradient(to bottom, rgba(26, 20, 15, 220) 0%, rgba(12, 9, 6, 220) 45%, rgba(4, 4, 3, 225) 100%);
	border-top-color: #e0b158;
	border-left-color: #e0b158;
	border-bottom-color: #050403;
	border-right-color: #050403;
	box-shadow:
		0 0 0 2dp #050403,
		0 0 0 3dp #8a5f2e,
		inset 0 0 0 4dp #0b0806,
		inset 0 0 0 5dp rgba(224, 177, 88, 45);
}
/* --------------------------------------------------------------------------
   Kryon letter chrome: rounded warm plate with a bright gold top rule.
   -------------------------------------------------------------------------- */
#frame_fill {
	background-color: rgba(12, 9, 6, 225);
	decorator:
		radial-gradient(circle at 70% 20%, rgba(184, 112, 43, 26), transparent 40%),
		linear-gradient(155deg, rgba(28, 24, 20, 225) 0%, rgba(12, 9, 6, 225) 55%, rgba(5, 8, 11, 230) 100%);
	border-radius: 14dp;
	box-shadow:
		0 0 0 2dp #050403,
		0 0 0 3dp #8a5f2e,
		inset 0 0 0 4dp #0b0806,
		inset 0 0 0 5dp rgba(224, 177, 88, 45);
	border-color: rgba(163, 111, 61, 217);
}