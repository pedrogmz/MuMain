/* Kryon theme: forked from themes/modern/mu_helper_bar.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* Modern theme for the MU Helper mini control bar + hero position readout -- flat programmatic
   chrome, no legacy sprite art. Same layout as themes/legacy/mu_helper_bar.rcss. */

#panel.workspace-placed { transform-origin: left top; }
#panel {
	position: absolute;
	width: 207dp;
	height: 25dp;
	font-family: "token(font-body)";
	font-size: 11dp;
	background-color: rgba(18, 14, 10, 190);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}

/* No legacy seam art -- the three segments collapse into #panel's own flat fill; elements stay in
   the document (data bindings target them by id) but render nothing of their own. */
#seg_a, #seg_b, #seg_c {
	display: none;
}

#text {
	position: absolute;
	left: 10dp;
	top: 5dp;
	width: 132dp;
	height: 9dp;
	text-align: center;
	color: token(text-primary);
	font-family: "token(font-body)";
	white-space: nowrap;
	pointer-events: none;
}

.mu-btn {
	position: absolute;
	top: 2dp;
	width: 18dp;
	height: 13dp;
	cursor: pointer;
	pointer-events: auto;
	background-color: token(surface-control);
	border: 1dp token(border-frame);
	border-radius: 2dp;
}
.mu-btn:hover {
	background-color: token(accent-steel);
	border: 1dp token(accent-steel);
}
#btn_config { left: 153dp; }
#btn_start  { left: 171dp; }
#btn_stop   { left: 171dp; }

/* Plain colored dot per button (no icon art) -- config: neutral, start: success, stop: danger. */
.dot {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 6dp;
	height: 6dp;
	transform: translate(-50%, -50%);
	border-radius: 3dp;
	pointer-events: none;
}
#btn_config .dot { background-color: token(semantic-neutral); }
#btn_start .dot  { background-color: token(semantic-success); }
#btn_stop .dot   { background-color: token(semantic-danger); }

/* --------------------------------------------------------------------------
   Kryon MU Helper bar: a gilded slate strip.
   -------------------------------------------------------------------------- */
#panel {
	background-color: rgba(14, 10, 7, 205);
	border-color: #8a5f2e;
	box-shadow:
		inset 0 1dp 0 rgba(255, 228, 163, 20),
		0 2dp 6dp rgba(0, 0, 0, 120);
}
.mu-btn {
	color: token(text-secondary);
	border-color: #7a5429;
}
.mu-btn:hover {
	color: token(accent-gold-hover);
	background-color: #332314;
	border-color: #e0b158;
}
/* --------------------------------------------------------------------------
   Kryon MU Helper bar: rounded warm deck with a gold top rule.
   -------------------------------------------------------------------------- */
#panel {
	background-color: rgba(11, 8, 6, 210);
	border-color: rgba(163, 111, 61, 217);
	border-radius: 12dp;
	box-shadow:
		inset 0 1dp 0 rgba(255, 228, 163, 24),
		0 6dp 16dp rgba(0, 0, 0, 140);
}
.mu-btn {
	color: token(text-secondary);
	border-color: #8a5f2e;
	border-radius: 8dp;
}
.mu-btn:hover {
	color: #ffe4a3;
	background-color: #332314;
	border-color: #ffd988;
	box-shadow: 0 0 12dp rgba(255, 195, 85, 55);
}