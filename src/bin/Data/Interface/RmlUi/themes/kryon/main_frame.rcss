/* Kryon theme for main_frame.rml: the gilded command deck. The life and mana orbs stand at the
   ends, the shield (SD) and stamina (AG) orbs at their outer feet, and the bronze skill bar between
   them holds the four item hotkeys, the five skill hotkeys and the current skill in ten slots, with
   the experience line along its lower rail and the tenth of the level on the gem below it.

   The art is in hud/, cut from the Season 6 HUD asset pack by
   tools/kryon_theme/make_kryon_hud_textures.py: every texture is drawn 2.4 texels to the dp, so
   the numbers below are its texel geometry divided by 2.4 (bar.OZT: 1024x151 -> 426.67x62.92dp).
   The orbs' liquid is not in the frame art: each gauge draws its glass (orb_*_fill) from the
   bottom up to its level.

   The corner buttons are in main_frame_top.rml, so #buttons is hidden here, as in modern. */

/* The original art, the bottom button row, the flat strip of the modern layout and the readout
   variant this theme doesn't use. */
.frame-art, .exp-frame, #buttons, .gauge-num.value-current,
#gauge_fill_left, #gauge_fill_right, #item_band_fill, #skill_band_fill, #gauge_frame,
.gauge-fill-horizontal {
	display: none;
}

/* The unit spans the orbs, centred at the bottom; the skill list may overflow above it. Every
   .hud-part is placed from the unit's left edge, its bottom from the unit's bottom. */
#hud_layout { position: absolute; left: 50%; bottom: 0; margin-left: -320dp;
    width: 640dp; height: 95dp; overflow: visible; pointer-events: none; }
#hud_layout.workspace-placed { margin-left: 0; bottom: auto; transform-origin: left top; }
.hud-part {
	position: absolute;
	font-family: "token(font-body)";
	font-size: 9dp;
}

/* The bar, centred. Its wells start 17.92dp below its top and are 28.17dp tall; the item and
   skill parts below stand in them. */
#hud_strip    { left: 106.67dp; bottom: 0dp;     width: 426.67dp; height: 62.92dp; pointer-events: auto;
                decorator: image(hud/bar.tga); }
#gauges_left  { left: 0dp;      bottom: 0dp;     width: 140dp;    height: 95dp; }
#gauges_right { left: 500dp;    bottom: 0dp;     width: 140dp;    height: 95dp; }
#item_slots   { left: 142.46dp; bottom: 16.83dp; width: 142.25dp; height: 28.17dp; }
#skill_slots  { left: 290.25dp; bottom: 16.83dp; width: 216dp;    height: 28.17dp; }
#exp          { left: 154.67dp; bottom: 6.5dp;   width: 345dp;    height: 6dp; pointer-events: auto; }
#skill_list   { left: 475.25dp; bottom: 66dp;    width: 32dp;     height: 38dp; }

/* ---- Orbs ----------------------------------------------------------------------------------
   Each gauge's box is its orb's art, padded so its content box is the glass: the frame and the
   empty glass are the box's decorator, and the fill, a flex item standing on the content box's
   bottom, is its level's share of the glass's height (main_frame.rml binds that height in %),
   showing the bottom of the glass's texture. The life and mana orbs' glass centres sit 70.1dp
   from the unit's ends; the small orbs' 34dp further out. pointer-events:auto is required --
   these would otherwise inherit body's `none` (base.rcss's pointer-events trap) and their hints
   could never show. */
.gauge-slot {
	position: absolute;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	border: none;
	background-color: transparent;
	pointer-events: auto;
}
#bar_hp { left: 6.9dp;   top: 0.7dp;  width: 78.42dp; height: 78.42dp; padding: 6.63dp 21.33dp 9.25dp 24dp;
          decorator: image(hud/orb_hp.tga); }
#bar_sd { left: 5.98dp;  top: 38.1dp; width: 36.75dp; height: 36.75dp; padding: 5.17dp 10.3dp 14.98dp 11.75dp;
          decorator: image(hud/orb_sd.tga); }
#bar_mp { left: 12.6dp;  top: 0.7dp;  width: 74.5dp;  height: 74.5dp;  padding: 6.38dp 20.36dp 13.42dp 20.08dp;
          decorator: image(hud/orb_mp.tga); }
#bar_ag { left: 75.05dp; top: 37.9dp; width: 33.83dp; height: 33.83dp; padding: 5.63dp 10.57dp 17.64dp 12dp;
          decorator: image(hud/orb_ag.tga); z-index: 1; }

.gauge-fill-vertical {
	display: block;
	flex: 0 0 auto;
	width: 100%;
}
.gauge-fill-hp          { decorator: image(hud/orb_hp_fill.tga cover center bottom); }
.gauge-fill-hp.poisoned { decorator: image(hud/orb_hp_poison.tga cover center bottom); }
.gauge-fill-mp          { decorator: image(hud/orb_mp_fill.tga cover center bottom); }
.gauge-fill-sd          { decorator: image(hud/orb_sd_fill.tga cover center bottom); }
.gauge-fill-ag          { decorator: image(hud/orb_ag_fill.tga cover center bottom); }

/* The current/max readout across each glass: in the upper part of the large orbs, clear of the
   small orb at their foot, and across the middle of the small ones. */
.gauge-num {
	position: absolute;
	color: #ffffff;
	font-weight: bold;
	font-family: "token(font-body)";
	font-effect: outline(1.5dp #000000);
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
}
/* Absolute children are placed from the padding box (the art), so each readout takes its glass's
   left and width from the padding above. */
#bar_hp .gauge-num, #bar_mp .gauge-num { font-size: 10dp; line-height: 10dp; }
#bar_sd .gauge-num, #bar_ag .gauge-num { font-size: 7.5dp; line-height: 7.5dp; }
#bar_hp .gauge-num { left: 24dp;    width: 78.42dp; top: 26.2dp; }
#bar_mp .gauge-num { left: 20.08dp; width: 74.5dp;  top: 24.7dp; }
#bar_sd .gauge-num { left: 11.75dp; width: 36.75dp; top: 19.8dp; }
#bar_ag .gauge-num { left: 12dp;    width: 33.83dp; top: 18.8dp; }

/* ---- Experience -----------------------------------------------------------------------------
   The line runs in the dark channel of the bar's lower rail (texels 124.7..131.2 down the bar);
   the part is a little taller, the area its hint answers in. The tenth of the level (0-9) is
   written on the rail's gem, centred under the frame between the item and skill slots. */
#exp_track {
	position: absolute;
	left: 0dp;
	top: 1.7dp;
	width: 345dp;
	height: 2.7dp;
}
#exp_fill {
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
	background-color: #e0b158;
	decorator: linear-gradient(to bottom, #fff0c0, #e0b158 45%, #8a5a1c);
}
#exp_digit {
	position: absolute;
	left: 125.17dp;
	top: -5.34dp;
	width: 15.92dp;
	height: 18.38dp;
	decorator: image(hud/bar_gem.tga);
	color: #ffffff;
	font-weight: bold;
	font-effect: outline(1dp #000000);
	font-family: "token(font-body)";
	font-size: 7.5dp;
	line-height: 18.38dp;
	text-align: center;
	pointer-events: none;
}

/* ---- Slots ----------------------------------------------------------------------------------
   Each slot is one of the bar's wells (31dp wide, the wells' pitch about 36.9dp). The art draws
   the wells' frames, so a slot has no border; a hovered or selected one glows gold inside. */
#item_slot_0, #item_slot_1, #item_slot_2, #item_slot_3,
#skill_slot_0, #skill_slot_1, #skill_slot_2, #skill_slot_3, #skill_slot_4,
#current_skill_slot {
	position: absolute;
	top: 0dp;
	width: 31dp;
	height: 28.17dp;
	border: none;
	border-radius: 3dp;
	pointer-events: auto;
	cursor: pointer;
}
#item_slot_0 { left: 0dp; }
#item_slot_1 { left: 36.5dp; }
#item_slot_2 { left: 74dp; }
#item_slot_3 { left: 111.25dp; }
#skill_slot_0 { left: 0dp; }
#skill_slot_1 { left: 36.5dp; }
#skill_slot_2 { left: 73.83dp; }
#skill_slot_3 { left: 110.83dp; }
#skill_slot_4 { left: 147.83dp; }
#current_skill_slot { left: 184.83dp; box-shadow: inset 0 0 6dp rgba(255, 195, 85, 70); }

#item_slots .selected, #skill_slots .selected {
	background-color: rgba(224, 177, 88, 30);
	box-shadow: inset 0 0 0 1dp #ffe4a3, inset 0 0 8dp rgba(255, 195, 85, 90);
}
/* The original RenderCenterFrame() quad, shown while the hotkey row is on its upper set: over
   the five skill slots. */
#skill_list_highlight { position: absolute; left: 0dp; top: 0dp; width: 178.83dp; height: 28.17dp;
                        border-radius: 3dp; background-color: rgba(255, 255, 255, 50); pointer-events: none; }

/* The item's 3D icon, centred in the well. */
.item-icon { position: absolute; left: 5.5dp; top: 4.08dp; width: 20dp; height: 20dp; pointer-events: none; }

/* Hotkeys at a well's upper left, as the art's letters were; a potion's count at its lower right. */
.slot-hotkey-label, .skill-hotkey-label {
	position: absolute;
	left: 4dp;
	top: 3.5dp;
	color: #ffffff;
	font-weight: bold;
	font-family: "token(font-body)";
	font-effect: outline(1dp #000000);
	font-size: 8dp;
	line-height: 8dp;
	white-space: nowrap;
	pointer-events: none;
}
.item-stack-label {
	position: absolute;
	right: 2dp;
	bottom: 2dp;
	color: #ffffff;
	font-weight: bold;
	font-family: "token(font-body)";
	font-effect: outline(1dp #000000);
	font-size: 8dp;
	line-height: 8dp;
	white-space: nowrap;
	pointer-events: none;
}

/* A skill icon (the sprite comes from C++, data-style-decorator) at the original's 20x28
   proportions, as tall as the well allows: 18.6x26 in a well, 20x28 centred in the list's
   32x38 cells. */
.skill-icon {
	position: absolute;
	left: 6.2dp;
	top: 1.08dp;
	width: 18.6dp;
	height: 26dp;
	pointer-events: none;
}
.skill-cell .skill-icon { left: 5dp; top: 4dp; width: 20dp; height: 28dp; }

/* Bottom-anchored translucent wipe -- shrinks from the top down as cooldown counts down.
   Height is bound per-instance (data-style-height, main_frame.rml). */
.cooldown-wipe {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	border-radius: 3dp;
	background-color: rgba(255, 128, 128, 128);
	pointer-events: none;
}

/* ---- Skill list -----------------------------------------------------------------------------
   Expanded grid + pet-command row, from #skill_list's corner (the first cell's box), just above
   the current skill's well. Containers stay non-interactive; only .skill-cell opts back in. */
#skill_grid, #pet_skill_row {
	position: absolute;
	left: 0;
	top: 0;
	pointer-events: none;
}
/* Each cell a small jewelled card in the bar's bronze. */
.skill-cell {
	position: absolute;
	width: 30dp;
	height: 36dp;
	pointer-events: auto;
	cursor: pointer;
	border: 1dp #8a5f2e;
	border-top-color: #c08a44;
	border-radius: token(radius-sm)dp;
	background-color: rgba(10, 7, 5, 215);
	box-shadow: inset 0 0 8dp rgba(0, 0, 0, 160), 0 2dp 6dp rgba(0, 0, 0, 140);
}
.skill-cell.selected {
	border-color: #ffe4a3;
	background-color: rgba(224, 177, 88, 34);
	box-shadow: 0 0 10dp rgba(255, 195, 85, 60), inset 0 0 8dp rgba(0, 0, 0, 140);
}
/* The original's zig-zag around the first cell, by each cell's place in the list (--i): the first
   fourteen alternate right and left of it, the next four continue left, and the rest form a second
   row above, heading right. */
#skill_grid .skill-cell { top: 0dp; }
#skill_grid .skill-cell:nth-child(2n+1):nth-child(-n+13) { left: calc(var(--i, 0) * 16dp); }
#skill_grid .skill-cell:nth-child(2n):nth-child(-n+14) { left: calc(var(--i, 0) * -16dp - 16dp); }
#skill_grid .skill-cell:nth-child(n+15):nth-child(-n+18) { left: calc(192dp - var(--i, 0) * 32dp); }
#skill_grid .skill-cell:nth-child(n+19) { left: calc(var(--i, 0) * 32dp - 928dp); top: -38dp; }
#pet_skill_row .skill-cell { top: -38dp; }
#pet_skill_row .skill-cell:nth-child(1) { left: -32dp; }
#pet_skill_row .skill-cell:nth-child(2) { left: 0dp; }
#pet_skill_row .skill-cell:nth-child(3) { left: 32dp; }
#pet_skill_row .skill-cell:nth-child(4) { left: 64dp; }
