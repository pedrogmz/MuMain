/* Kryon theme: forked from themes/modern/npc_shop.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* Modern theme for CNPCShop's chrome -- header/repair-buttons/repair-money strip are vector
   forged-metal chrome (matching Login/SysMenu/MyInventory/Storage Ext's forged-dialog language).
   The grid's items stay live 3D, drawn by C++. No exit button -- the frame's corner "X" closes
   it. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:7 matches MyInventory/SysMenu's own rail top (keeps .modern-joint-px's rivet at the same
   -1px relative to the frame's shell edge at -3px -- contained, identical relationship to
   those windows). height:42 (not MyInventory's 36, or Storage Ext's 29) budgets for this window's
   own TWO-line title (title + tax-rate) rather than either reference's single line -- this grid
   starts at `m_Pos.y + 50` (NPCShop.cpp), a full 50px budget: ends at 49px, 1px clear. */
.shop-header-rail {
	top: 7px;
	height: 42px;
}

/* Overrides modern-header-text-px's left-aligned single-line layout with a full-width centered
   two-line block, matching this window's own native RT3_SORT_CENTER title/tax-rate lines (unlike
   MyInventory/Storage Ext's left-aligned single title). margin-top approximates vertical centering
   of the ~24px-tall two-line block within the 42px rail. */
.shop-header-text-px {
	left: 0;
	width: 190px;
	text-align: center;
	margin-top: -13px;
}
.shop-tax-rate-px {
	display: block;
	margin-top: 2px;
}

/* Repair/Repair-All buttons: same 37x26 chrome as every other CInventoryCtrl-owning window's
   corner buttons (base.rcss's .modern-icon-btn-px). Both use the same repair glyph -- the native
   buttons shared one identical sprite (newui_repair_00.tga) too, differing only by tooltip. */
.shop-btn-repair     { left: 54px; }
.shop-btn-repair-all { left: 98px; }

/* Repair-money strip: this window's own 10/355/170/24 native geometry (RenderRepairMoney()), not
   MyInventory's 15/366/160 gold-strip column -- overridden per .modern-wallet-px's own base.rcss
   comment inviting exactly this for a window whose layout doesn't share Inventory's column. */
.shop-repair-wallet {
	left: 10px;
	top: 355px;
	width: 170px;
	height: 24px;
}
.shop-repair-value {
	top: 360px;
}
.shop-repair-wallet.hidden,
.shop-repair-value.hidden {
	display: none;
}

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 50px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #0b0806;
	decorator: linear-gradient(to bottom, #15100c 0%, #0b0806 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #080604,
		inset 0 0 0 3px rgba(224, 177, 88, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(36, 26, 18, 242);
	box-shadow:
		inset 1px 0 0 rgba(224, 177, 88, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(255, 216, 135, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #2a1e14;
	box-shadow:
		inset 0 0 0 1px rgba(224, 177, 88, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .shop-header-rail (npc_shop.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 42px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 16), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #16100b;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 22),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#b99a63 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }

/* --------------------------------------------------------------------------
   Kryon inventory-family chrome: the loader shell's double gold ring around a
   warm obsidian plate. Paint only -- dimensions and placement stay above.
   -------------------------------------------------------------------------- */
.bg-panel {
	background-color: #0d0906;
	decorator:
		radial-gradient(ellipse at top, rgba(202, 132, 38, 34), transparent 64%),
		linear-gradient(120deg, rgba(28, 24, 20, 247), rgba(5, 8, 11, 247));
	border-color: #e0b158;
	box-shadow:
		0 0 0 3px #050403,
		0 0 0 4px #8a5f2e,
		inset 0 0 0 6px #0b0806,
		inset 0 0 0 7px rgba(160, 110, 60, 60),
		0 18px 46px rgba(0, 0, 0, 170);
}
.inv-shell-edge {
	border-color: rgba(36, 26, 18, 242);
	box-shadow:
		inset 1px 0 0 rgba(255, 216, 135, 90),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(255, 216, 135, 80),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}
.inv-groove {
	border-color: #3a2b1c;
	box-shadow:
		inset 0 0 0 1px rgba(224, 177, 88, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}
.rail-fill {
	background-color: #17110c;
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 18), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-color: #7a5429;
	border-bottom-color: #16100b;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 30),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* --------------------------------------------------------------------------
   Kryon inventory family: warm obsidian plate, rounded gold frame, top sheen.
   -------------------------------------------------------------------------- */
.bg-panel {
	background-color: #0b0806;
	decorator:
		radial-gradient(circle at 70% 20%, rgba(184, 112, 43, 26), transparent 40%),
		linear-gradient(to bottom, rgba(24, 20, 18, 247), rgba(5, 5, 6, 250));
	border-color: rgba(163, 111, 61, 217);
	border-radius: 14px;
	box-shadow:
		0 24px 70px rgba(0, 0, 0, 199),
		inset 0 0 0 2px rgba(0, 0, 0, 173);
}
.inv-shell-edge {
	border-color: rgba(36, 26, 18, 242);
	border-radius: 18px;
	box-shadow:
		inset 1px 0 0 rgba(255, 216, 135, 90),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(255, 228, 163, 80),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}
.inv-groove {
	border-color: #3a2b1c;
	border-radius: 13px;
	box-shadow:
		inset 0 0 0 1px rgba(224, 177, 88, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}
.rail-fill {
	background-color: #17110c;
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 22), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-color: #6b4a2a;
	border-top-color: #c08a44;
	border-bottom-color: #16100b;
	border-radius: 8px;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 30),
		inset 0 -1px 0 #000000,
		0 2px 6px rgba(0, 0, 0, 133);
}