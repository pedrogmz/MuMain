/* Kryon theme: forked from themes/modern/main_frame_top.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* Modern theme's top-right system-button panel (main_frame_top.rml). */

/* #top_right_row / #buttons_top: the top-right system-button panel. #top_right_row is a
   full-width flex row anchored at screen (0,0); `justify-content:flex-end` pushes #buttons_top to
   the right edge. #buttons_top visually echoes mu_helper_bar.rcss's panel/button styling
   (values copied, not shared -- the documents stay independent). */
#top_right_row {
	width: 100%;
	display: flex;
	justify-content: flex-end;
}
#buttons_top.workspace-placed { position: absolute; transform-origin: left top; }
#buttons_top {
	position: relative;
	width: 256dp;
	height: 24dp;
	font-family: "token(font-body)";
	background-color: rgba(18, 14, 10, 190);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}
.frame-btn-top {
	position: absolute;
	top: 4dp;
	width: 48dp;
	height: 16dp;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 16dp;
	font-family: "token(font-body)";
	background-color: token(surface-control);
	border: 1dp token(border-frame);
	border-radius: 2dp;
	color: #ffffff;
	font-weight: bold;
	font-effect: outline(1dp #000000);
	font-size: 8dp;
}
.frame-btn-top:hover,
.frame-btn-top.open {
	background-color: token(accent-steel);
	border: 1dp token(accent-steel);
}
#btn_cshop_top    { left: 4dp;   }
#btn_chainfo_top  { left: 54dp;  }
#btn_myinven_top  { left: 104dp; }
#btn_friend_top   { left: 154dp; }
#btn_window_top   { left: 204dp; }

.alert-dot-top {
	position: absolute;
	top: -2dp;
	right: -2dp;
	width: 6dp;
	height: 6dp;
	border-radius: token(radius-sm)dp;
	background-color: token(semantic-warning);
	border: 1dp rgba(0, 0, 0, 150);
	pointer-events: none;
}


/* --------------------------------------------------------------------------
   Kryon top-right system bar: a gilded slate strip instead of green-black iron.
   -------------------------------------------------------------------------- */
#buttons_top {
	background-color: rgba(14, 10, 7, 205);
	border-color: #8a5f2e;
	box-shadow:
		inset 0 1dp 0 rgba(255, 228, 163, 20),
		0 2dp 6dp rgba(0, 0, 0, 120);
}
.frame-btn-top {
	color: token(text-primary);
	background-color: rgba(255, 226, 156, 8);
	border-color: #7a5429;
}
.frame-btn-top:hover,
.frame-btn-top.open {
	color: token(accent-gold-hover);
	background-color: #332314;
	border-color: #e0b158;
}
/* --------------------------------------------------------------------------
   Kryon top-right system bar: rounded warm deck with a gold top rule.
   -------------------------------------------------------------------------- */
#buttons_top {
	background-color: rgba(11, 8, 6, 210);
	border-color: rgba(163, 111, 61, 217);
	border-radius: 12dp;
	box-shadow:
		inset 0 1dp 0 rgba(255, 228, 163, 24),
		0 6dp 16dp rgba(0, 0, 0, 140);
}
.frame-btn-top {
	color: token(text-primary);
	background-color: rgba(255, 226, 156, 8);
	border-color: #8a5f2e;
	border-radius: 8dp;
}
.frame-btn-top:hover,
.frame-btn-top.open {
	color: #ffe4a3;
	background-color: #332314;
	border-color: #ffd988;
	box-shadow: 0 0 12dp rgba(255, 195, 85, 55);
}