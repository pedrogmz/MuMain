/* Kryon theme: forked from themes/modern/my_shop.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* Modern theme for CMyShopInventory's chrome -- header/shop-name field/buttons are vector
   forged-metal chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-dialog language).
   Only the inventory grid stays native, same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* No .modern-header-rail-px override -- the default (top:7/height:38) already clears this
   window's grid start (`m_Pos.y + 90`) and the edit-box strip below it. */

/* Shop-name field: placement/size only -- the forged-metal fill, border and focus/error/disabled
   states all come from base.rcss's shared .text-field. Same 169x26 @ (12,49) box the #edit_bg strip
   occupied before the field itself became RmlUi; padding-left keeps the first glyph where the native
   CUITextInputBox drew it (SetPosition(m_Pos.x + 50, ...)). */
.my-shop-title-field {
	position: absolute;
	left: 12px;
	top: 49px;
	width: 169px;
	height: 26px;
	padding: 6px 6px 0 38px;
	font-size: 12px;
}

/* Buttons: base.rcss's shared .modern-icon-btn-px family at its default 37x26/top:392 geometry --
   only left offsets differ (13/53/93, this window's own native spacing). */
.shop-btn-exit  { left: 13px; color: #e9c987; border-color: #b08248; }
.shop-btn-open  { left: 53px; }
.shop-btn-close { left: 93px; }

/* Former RenderTextInfo()'s colours; shop_notice.rcss lays the notice out. */
.myshop-line-still-opening { color: token(text-warm); }
.myshop-line-warning { color: token(semantic-danger); }
.myshop-line-info { color: token(text-warm); }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 16px; top: 90px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #0b0806;
	decorator: linear-gradient(to bottom, #15100c 0%, #0b0806 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #080604,
		inset 0 0 0 3px rgba(224, 177, 88, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(36, 26, 18, 242);
	box-shadow:
		inset 1px 0 0 rgba(224, 177, 88, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(255, 216, 135, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #2a1e14;
	box-shadow:
		inset 0 0 0 1px rgba(224, 177, 88, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match its default (my_shop.rcss has no override). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 38px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 16), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #16100b;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 22),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#b99a63 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }

/* --------------------------------------------------------------------------
   Kryon inventory-family chrome: the loader shell's double gold ring around a
   warm obsidian plate. Paint only -- dimensions and placement stay above.
   -------------------------------------------------------------------------- */
.bg-panel {
	background-color: #0d0906;
	decorator:
		radial-gradient(ellipse at top, rgba(202, 132, 38, 34), transparent 64%),
		linear-gradient(120deg, rgba(28, 24, 20, 247), rgba(5, 8, 11, 247));
	border-color: #e0b158;
	box-shadow:
		0 0 0 3px #050403,
		0 0 0 4px #8a5f2e,
		inset 0 0 0 6px #0b0806,
		inset 0 0 0 7px rgba(160, 110, 60, 60),
		0 18px 46px rgba(0, 0, 0, 170);
}
.inv-shell-edge {
	border-color: rgba(36, 26, 18, 242);
	box-shadow:
		inset 1px 0 0 rgba(255, 216, 135, 90),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(255, 216, 135, 80),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}
.inv-groove {
	border-color: #3a2b1c;
	box-shadow:
		inset 0 0 0 1px rgba(224, 177, 88, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}
.rail-fill {
	background-color: #17110c;
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 18), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-color: #7a5429;
	border-bottom-color: #16100b;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 30),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* --------------------------------------------------------------------------
   Kryon inventory family: warm obsidian plate, rounded gold frame, top sheen.
   -------------------------------------------------------------------------- */
.bg-panel {
	background-color: #0b0806;
	decorator:
		radial-gradient(circle at 70% 20%, rgba(184, 112, 43, 26), transparent 40%),
		linear-gradient(to bottom, rgba(24, 20, 18, 247), rgba(5, 5, 6, 250));
	border-color: rgba(163, 111, 61, 217);
	border-radius: 14px;
	box-shadow:
		0 24px 70px rgba(0, 0, 0, 199),
		inset 0 0 0 2px rgba(0, 0, 0, 173);
}
.inv-shell-edge {
	border-color: rgba(36, 26, 18, 242);
	border-radius: 18px;
	box-shadow:
		inset 1px 0 0 rgba(255, 216, 135, 90),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(255, 228, 163, 80),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}
.inv-groove {
	border-color: #3a2b1c;
	border-radius: 13px;
	box-shadow:
		inset 0 0 0 1px rgba(224, 177, 88, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}
.rail-fill {
	background-color: #17110c;
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 22), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-color: #6b4a2a;
	border-top-color: #c08a44;
	border-bottom-color: #16100b;
	border-radius: 8px;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 30),
		inset 0 -1px 0 #000000,
		0 2px 6px rgba(0, 0, 0, 133);
}