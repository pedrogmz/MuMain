/* Kryon theme: forked from themes/modern/chat_log.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* Modern theme for CChatLogWindow. Same geometry as legacy (native's own 281 width / 15 line
   pitch / 4 side edges / 5 top inset -- see legacy/chat_log.rcss for where those come from), but
   the per-type colours are restated in this theme's token palette instead of native's saturated
   RGBA pairs.

   The message TYPES are semantic, so they keep distinct hues here too -- a player has to tell a
   whisper from a guild message at a glance, which is behaviour, not decoration. What changes is
   the treatment: flat token-driven left-edge accents on a common recessed ground, rather than
   nine fully-saturated fills. */

#panel.workspace-placed { bottom: auto; transform-origin: left top; }
#panel {
	position: absolute;
	left: 0;
	bottom: 97dp;
	width: 281dp;
	font-family: "token(font-body)";
	font-size: 1rem;
	pointer-events: none;
	border-radius: token(radius-sm)px;
}

/* The window fill -- see legacy/chat_log.rcss's note on the three-way split. C++ supplies only the
   fade and the frame state; what the backdrop actually looks like is entirely this rule's, flat or
   decorated. The same dark-panel gradient docked_panel_frame.rcss gives this theme's docked
   windows, so the chat log reads as part of that family rather than a flat black rectangle. */
#chat_backdrop {
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 0;
	decorator: linear-gradient(to bottom, #15100c 0%, #0b0806 100%);
	border-radius: token(radius-sm)px;
}
#panel.framed #chat_backdrop { display: block; }
/* Above the backdrop, and unfaded. */
#lines { position: relative; z-index: 1; }

#resize_handle {
	position: absolute;
	left: 0;
	top: -10dp;
	width: 281dp;
	height: 6dp;
	background-color: token(metal-rail-dark);
	border-radius: token(radius-sm)px;
	cursor: move;
	drag: drag;
	pointer-events: auto;
}
#resize_handle:hover { background-color: token(metal-edge); }
#resize_handle:active { background-color: token(metal-highlight); }

/* Bottom-up stacking and the frame-gated scrollbar -- see legacy/chat_log.rcss for why each is
   shaped this way (both trace to native's RenderMessages()/RenderFrame()). Behaviour is identical
   in both themes; only the scrollbar's own width differs, matching each theme's chrome. */
#lines {
	position: absolute;
	left: 4dp;
	top: 5dp;
	right: 4dp;
	font-size: 11dp;
	display: flex;
	flex-direction: column;
	/* Lines hug their own text rather than stretching to the pane: native passed no box width to
	   RenderText(), so the text renderer fell back to the MEASURED width for its background quad
	   (CUIRenderTextSDLTtf.cpp -- `if (layout.boxWidth == 0) boxWidth = measuredWidth`). Flex
	   defaults to align-items:stretch, which made every line a full-width bar instead. */
	align-items: flex-start;
}
.chat-line:first-child { margin-top: auto; }

/* The message well must NOT be a hover target. Core::Input::IsMouseOverUI() gates click-to-move
   on Rml::Context::IsMouseInteracting(), which is true for ANY pointer-events:auto element under
   the cursor -- clicked or not -- so leaving .scroll-pane's own `pointer-events: auto` in place
   here turned the whole chat area into a wall the player could not walk through. Native let world
   clicks pass straight through this window (its UpdateMouseEvent() only consumed on the single
   hover-transition frame), so nothing here may claim the cursor except the two controls that
   genuinely need it. */
#lines { pointer-events: none; }
.chat-line { pointer-events: none; }

/* The scrollbar is the exception, and it has to opt back in explicitly at every level: its
   generated children inherit pointer-events from #lines, which is now `none`. */
#lines scrollbarvertical,
#lines scrollbarvertical slidertrack,
#lines scrollbarvertical sliderbar { pointer-events: auto; }

/* Native's RenderFrame() draws the scrollbar AND the resize handle only while the frame is
   shown, so hiding the frame (F5) takes the scrollbar with it. Width 0 rather than
   overflow:hidden: native still scrolls on the wheel with the frame hidden. */
#lines scrollbarvertical { width: 0; }
#panel.framed #lines scrollbarvertical { width: 8dp; }

.chat-line {
	display: block;
	line-height: 15dp;
	white-space: nowrap;
	padding: 0 4dp;
	border-left: 2dp transparent;
	background-color: rgba(0, 0, 0, 130);
	color: token(text-primary);
}

/* Left-edge accent carries the type; the ground stays common. Hues track the same semantics
   native encodes in its fills (gold whisper, cyan party, green guild, yellow union, olive gens,
   blue system, red error, gold-on-dark GM). */
.chat-line--chat    { border-left-color: transparent; }
.chat-line--whisper { border-left-color: rgb(255, 200, 50);  color: rgb(255, 214, 120); }
.chat-line--system  { border-left-color: rgb(100, 150, 255); color: rgb(150, 185, 255); }
.chat-line--error   { border-left-color: rgb(255, 60, 40);   color: rgb(255, 120, 100); }
.chat-line--party   { border-left-color: rgb(0, 200, 255);   color: rgb(130, 225, 255); }
.chat-line--guild   { border-left-color: rgb(0, 255, 150);   color: rgb(130, 255, 200); }
.chat-line--union   { border-left-color: rgb(200, 200, 0);   color: rgb(230, 230, 130); }
.chat-line--gens    { border-left-color: rgb(150, 200, 100); color: rgb(200, 230, 170); }
.chat-line--gm      { border-left-color: token(accent-gold); color: token(accent-gold); font-weight: bold; }

/* Legacy drops chat-line alpha while the frame is shown so the frame fill reads through; the same
   need exists here, stated against this theme's own ground. */
#panel.framed .chat-line { background-color: rgba(0, 0, 0, 80); }

.chat-line--pointed {
	background-color: token(surface-control);
	color: token(text-primary);
}

/* --------------------------------------------------------------------------
   Kryon chat frame: rounded warm obsidian with a gold top rule.
   -------------------------------------------------------------------------- */
#chat_backdrop {
	background-color: rgba(11, 8, 6, 210);
	decorator:
		radial-gradient(circle at 70% 20%, rgba(184, 112, 43, 26), transparent 40%),
		linear-gradient(to bottom, rgba(24, 20, 18, 240), rgba(5, 5, 6, 245));
	border: 1dp #8a5f2e;
	border-radius: 10dp;
	box-shadow: 0 8dp 22dp rgba(0, 0, 0, 150);
	border-color: rgba(163, 111, 61, 217);
}
#resize_handle {
	border-radius: 4dp;
}
.chat-line--gm {
	color: #ffe4a3;
	border-left-color: #ffd988;
}
/* Kryon art pass (base.rcss): the framed chat is a dark plate in a bronze edge. */
#chat_backdrop {
	background-color: transparent;
	border-color: transparent;
	decorator: ninepatch(kryon-panel, kryon-panel-inner, 8dp 9dp 8dp 9dp);
	opacity: 0.88;
}

/* --------------------------------------------------------------------------
   Kryon chat deck: the Season 6 chat frame. Pairs with this folder's chat_log.rml fork (#chat_ring)
   and chat_input.rml fork (the tabs and field under it). The pieces are cut by
   tools/kryon_theme/make_kryon_chat_textures.py, which prints the rects below.
   -------------------------------------------------------------------------- */
@spritesheet kryon-chat-thumb-sheet { src: ui/chat_thumb.tga;
	kryon-chat-thumb: 0px 0px 12px 44px; kryon-chat-thumb-inner: 0px 5px 12px 34px; }

/* The ring with gold corner gems, over the plate's edge; unfaded by the transparency step. */
#chat_ring {
	display: none;
	position: absolute;
	left: -5dp;
	top: -5dp;
	right: -5dp;
	bottom: -5dp;
	z-index: 2;
	pointer-events: none;
	decorator: ninepatch(kryon-frame, kryon-frame-inner, 17dp 17dp 17dp 17dp);
}
#panel.framed #chat_ring { display: block; }

/* The resize grip: a short bronze rail centred over the ring's top edge. */
#resize_handle {
	left: 110dp;
	width: 61dp;
	top: -12dp;
	height: 6dp;
	z-index: 3;
	border-radius: 3dp;
	background-color: rgba(122, 84, 41, 200);
}
#resize_handle:hover { background-color: #c9a55a; }
#resize_handle:active { background-color: #ffd988; }

/* Lines: the type's colour carries it, as in the Season 6 deck -- no accent bar. Over the world
   (frame off) each line keeps a soft ground; on the plate it needs none. */
.chat-line { border-left-width: 0; padding: 0 3dp; }
#panel.framed .chat-line { background-color: transparent; }
#panel.framed .chat-line--pointed { background-color: rgba(163, 111, 61, 70); }
#panel.framed #lines { left: 7dp; top: 6dp; right: 4dp; }

/* The scrollbar: a dark groove between two bronze arrows, with the upright bar frame as thumb.
   The arrows step the view a line at a time (RmlUi's own slider arrows). */
#panel.framed #lines scrollbarvertical { width: 12dp; margin-left: 3dp; }
#lines scrollbarvertical slidertrack {
	background-color: rgba(5, 4, 3, 200);
	border: 1dp rgba(122, 84, 41, 180);
	border-radius: 3dp;
}
#lines scrollbarvertical sliderbar {
	background-color: transparent;
	box-shadow: none;
	border-radius: 0;
	min-height: 16dp;
	decorator: ninepatch(kryon-chat-thumb, kryon-chat-thumb-inner, 4dp 0dp 4dp 0dp);
}
#lines scrollbarvertical sliderbar:hover,
#lines scrollbarvertical sliderbar:active {
	background-color: transparent;
	filter: brightness(1.3);
}
#panel.framed #lines scrollbarvertical sliderarrowdec,
#panel.framed #lines scrollbarvertical sliderarrowinc {
	width: 12dp;
	height: 9dp;
	pointer-events: auto;
	cursor: pointer;
}
#panel.framed #lines scrollbarvertical sliderarrowdec { decorator: image(ui/chat_arrow_up.tga); margin-bottom: 1dp; }
#panel.framed #lines scrollbarvertical sliderarrowinc { decorator: image(ui/chat_arrow_down.tga); margin-top: 1dp; }
#lines scrollbarvertical sliderarrowdec:hover,
#lines scrollbarvertical sliderarrowinc:hover { filter: brightness(1.4); }
