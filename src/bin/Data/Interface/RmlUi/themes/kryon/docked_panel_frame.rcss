/* Kryon theme: forked from themes/modern/docked_panel_frame.rcss. The structure and selectors are modern's;
   the literal palette below is remapped to Kryon's warm obsidian and gilded bronze. Keep this file in
   step when the modern original changes. */

/* Shared forged-dialog frame for the right-docked single-document window family:
   character_info, my_quest_info, pet_info, party_info -- all read as one visual family on screen
   (same right-hand docking slots), so their modern-theme chrome should match, not diverge by
   window. Link this BEFORE the window's own .rcss.

   Reuses base.rcss's already-shared .modern-shell-edge/.modern-groove/.modern-header-rail-px/
   .modern-joint-px/.modern-header-text-px/.modern-header-title-px/.modern-icon-btn-px directly
   (every consumer here already links base.rcss) rather than re-declaring them; each window's RML
   applies the shared classes directly. Only the PAINT that base.rcss's shared classes don't
   already cover (the #panel gradient/border/box-shadow body, and the header-rail's own
   fill/border/box-shadow + accent line) lives here -- these four windows share this one
   forged-dialog recipe so they render as one family. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
	border-radius: token(radius-sm)px;
	background-color: #0b0806;
	decorator: linear-gradient(to bottom, #15100c 0%, #0b0806 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #080604,
		inset 0 0 0 3px rgba(224, 177, 88, 190);
}

.frame-piece { display: none; }

/* Header-rail paint -- position comes from base.rcss's .modern-header-rail-px, applied alongside
   this class in the RML; each window's own class (e.g. .chainfo-header-rail) only needs to override
   top/height when it differs from this default (38px tall, matching CMyInventory/CSysMenuWin). */
.docked-header-rail-fill {
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(255, 216, 135, 16), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #1c1814 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #16100b;
	box-shadow:
		inset 0 1px 0 rgba(255, 228, 163, 22),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .docked-header-rail-fill so left/right/bottom resolve against it. */
.docked-rail-accent {
	position: absolute;
	left: -1px;
	right: -1px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#b99a63 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* A theme's data-fit="fill" slot sizes #panel (class fill-placement), its border included. */
#panel.fill-placement { box-sizing: border-box; }

/* --------------------------------------------------------------------------
   Kryon right-dock chrome: the web client's command panel -- an even bronze
   ring, 14px corners, an obsidian fade and an inner black ring. Paint only.
   -------------------------------------------------------------------------- */
#panel {
	background-color: #0b0908;
	decorator:
		radial-gradient(circle at 70% 20%, rgba(184, 112, 43, 26), transparent 40%),
		linear-gradient(to bottom, rgba(24, 20, 18, 250), rgba(5, 5, 6, 250));
	border-color: rgba(163, 111, 61, 217);
	border-radius: 14px;
	box-shadow:
		0 24px 70px rgba(0, 0, 0, 199),
		inset 0 0 0 2px rgba(0, 0, 0, 173);
}
.docked-header-rail-fill {
	background-color: transparent;
	decorator: none;
	border-color: transparent;
	border-bottom-color: rgba(185, 132, 72, 128);
	border-radius: 0;
	box-shadow: none;
}
